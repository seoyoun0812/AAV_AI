def extract_initial_esm_embeddings(model, train_loader, val_loader, test_loader, device):
    """Extract initial ESM embeddings (input to GNN) for all datasets
    
    Now extracts per-residue embeddings and averages them for sequence-level representation
    """
    all_embeddings = []
    all_targets = []
    all_protein_ids = []
    all_sequences = []
    all_dataset_labels = []
    
    model.eval()
    
    with torch.no_grad():
        for loader, dataset_name in [(train_loader, 'train'), 
                                     (val_loader, 'validation'),
                                     (test_loader, 'test')]:
            
            print(f"Processing {dataset_name} dataset...")
            
            for batch_idx, (accs, seqs, targets) in enumerate(tqdm.tqdm(loader, desc=dataset_name)):
                try:
                    # Get per-residue ESM embeddings
                    esm_embeddings = model.get_ESM_embeddings(accs, seqs)
                    
                    for i in range(len(accs)):
                        # Average per-residue embeddings to get sequence-level representation
                        embedding = esm_embeddings[i].mean(dim=0).cpu().numpy()  # [d_ESM]
                        
                        all_embeddings.append(embedding)
                        all_targets.append(targets[i].item())
                        all_protein_ids.append(accs[i])
                        all_sequences.append(seqs[i])
                        all_dataset_labels.append(dataset_name)
                        
                except Exception as e:
                    print(f"Error in batch {batch_idx}: {e}")
                    continue
    
    return {
        'embeddings': np.vstack(all_embeddings),
        'targets': np.array(all_targets),
        'protein_ids': all_protein_ids,
        'sequences': all_sequences,
        'dataset_labels': all_dataset_labels,
        'predictions': np.zeros(len(all_targets))
    }


def extract_gnn_representations(model, train_loader, val_loader, test_loader, device, stage=""):
    """Extract GNN output representations and predictions for all datasets"""
    all_embeddings = []
    all_predictions = []
    all_targets = []
    all_protein_ids = []
    all_sequences = []
    all_dataset_labels = []
    
    model.eval()
    
    with torch.no_grad():
        for loader, dataset_name in [(train_loader, 'train'),
                                     (val_loader, 'validation'),
                                     (test_loader, 'test')]:
            
            print(f"Processing {dataset_name} dataset ({stage})...")
            
            for batch_idx, (accs, seqs, targets) in enumerate(tqdm.tqdm(loader, desc=dataset_name)):
                try:
                    targets = targets.to(device)
                    
                    predictions, gnn_embeddings = model(accs, seqs)
                    
                    all_embeddings.append(gnn_embeddings.cpu().numpy())
                    all_predictions.extend(predictions.cpu().numpy())
                    all_targets.extend(targets.cpu().numpy())
                    all_protein_ids.extend(accs)
                    all_sequences.extend(seqs)
                    all_dataset_labels.extend([dataset_name] * len(accs))
                    
                except Exception as e:
                    print(f"Error in batch {batch_idx}: {e}")
                    continue
    
    all_embeddings = np.vstack(all_embeddings) if all_embeddings else np.array([])
    
    return {
        'embeddings': all_embeddings,
        'predictions': np.array(all_predictions),
        'targets': np.array(all_targets),
        'protein_ids': all_protein_ids,
        'sequences': all_sequences,
        'dataset_labels': all_dataset_labels
    }


def save_representations_to_csv(representations_dict, csv_path, representation_type='gnn_output'):
    """Save representations to CSV file with proper formatting"""
    
    df_data = {
        'protein_id': representations_dict['protein_ids'],
        'dataset': representations_dict['dataset_labels'],
        'target': representations_dict['targets']
    }
    
    if representation_type == 'gnn_output':
        df_data['prediction'] = representations_dict['predictions']
        df_data['error'] = representations_dict['predictions'] - representations_dict['targets']
    
    embeddings = representations_dict['embeddings']
    n_dims = embeddings.shape[1]
    
    for i in range(n_dims):
        df_data[f'dim_{i}'] = embeddings[:, i]
    
    df = pd.DataFrame(df_data)
    
    metadata = {
        'representation_type': representation_type,
        'embedding_dimensions': n_dims,
        'total_samples': len(df),
        'train_samples': len(df[df['dataset'] == 'train']),
        'val_samples': len(df[df['dataset'] == 'validation']),
        'test_samples': len(df[df['dataset'] == 'test'])
    }
    
    df.to_csv(csv_path, index=False, float_format='%.6f')
    
    metadata_path = csv_path.replace('.csv', '_metadata.txt')
    with open(metadata_path, 'w') as f:
        for key, value in metadata.items():
            f.write(f"{key}: {value}\n")
    
    print(f"  Saved {len(df)} samples with {n_dims} dimensions")
    print(f"  Dataset distribution: train={metadata['train_samples']}, "
          f"val={metadata['val_samples']}, test={metadata['test_samples']}")


