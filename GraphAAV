class GNNLayer(nn.Module):
    def __init__(self, num_hidden, dropout=0.0, num_heads=4):
        super(GNNLayer, self).__init__()
        self.dropout = nn.Dropout(dropout)
        self.norm = nn.ModuleList([nn.BatchNorm1d(num_hidden) for _ in range(2)])

        self.attention = TransformerConv(
            in_channels=num_hidden, 
            out_channels=int(num_hidden / num_heads), 
            heads=num_heads, 
            dropout=dropout, 
            edge_dim=num_hidden, 
            root_weight=False
        )
        self.PositionWiseFeedForward = nn.Sequential(
            nn.Linear(num_hidden, num_hidden*4),
            nn.ReLU(),
            nn.Linear(num_hidden*4, num_hidden)
        )
        self.edge_update = EdgeMLP(num_hidden, dropout)
        self.context = Context(num_hidden)

    def forward(self, h_V, edge_index, h_E, batch_id):
        dh = self.attention(h_V, edge_index, h_E)
        h_V = self.norm[0](h_V + self.dropout(dh))

        dh = self.PositionWiseFeedForward(h_V)
        h_V = self.norm[1](h_V + self.dropout(dh))

        h_E = self.edge_update(h_V, edge_index, h_E)
        h_V = self.context(h_V, batch_id)

        return h_V, h_E


class EdgeMLP(nn.Module):
    def __init__(self, num_hidden, dropout=0.0):
        super(EdgeMLP, self).__init__()
        self.dropout = nn.Dropout(dropout)
        self.norm = nn.BatchNorm1d(num_hidden)
        self.W11 = nn.Linear(3*num_hidden, num_hidden, bias=True)
        self.W12 = nn.Linear(num_hidden, num_hidden, bias=True)
        self.act = torch.nn.GELU()

    def forward(self, h_V, edge_index, h_E):
        src_idx = edge_index[0]
        dst_idx = edge_index[1]

        h_EV = torch.cat([h_V[src_idx], h_E, h_V[dst_idx]], dim=-1)
        h_message = self.W12(self.act(self.W11(h_EV)))
        h_E = self.norm(h_E + self.dropout(h_message))
        return h_E


class Context(nn.Module):
    def __init__(self, num_hidden):
        super(Context, self).__init__()
        self.V_MLP_g = nn.Sequential(
            nn.Linear(num_hidden, num_hidden),
            nn.ReLU(),
            nn.Linear(num_hidden, num_hidden),
            nn.Sigmoid()
        )

    def forward(self, h_V, batch_id):
        c_V = scatter_mean(h_V, batch_id, dim=0)
        h_V = h_V * self.V_MLP_g(c_V[batch_id])
        return h_V


class Graph_encoder(nn.Module):
    def __init__(self, node_in_dim, edge_in_dim, hidden_dim,
                 num_layers=4, drop_rate=0.2, num_heads=4):
        super(Graph_encoder, self).__init__()
        
        self.node_embedding = nn.Linear(node_in_dim, hidden_dim, bias=True)
        self.edge_embedding = nn.Linear(edge_in_dim, hidden_dim, bias=True)
        self.norm_nodes = nn.BatchNorm1d(hidden_dim)
        self.norm_edges = nn.BatchNorm1d(hidden_dim)
        
        self.W_v = nn.Linear(hidden_dim, hidden_dim, bias=True)
        self.W_e = nn.Linear(hidden_dim, hidden_dim, bias=True)
        
        self.layers = nn.ModuleList([
            GNNLayer(num_hidden=hidden_dim, dropout=drop_rate, num_heads=num_heads)
            for _ in range(num_layers)
        ])

    def forward(self, h_V, edge_index, h_E, batch_id):
        device = h_V.device
        edge_index = edge_index.to(device)
        h_E = h_E.to(device)
        batch_id = batch_id.to(device)
        
        h_V = self.W_v(self.norm_nodes(self.node_embedding(h_V)))
        h_E = self.W_e(self.norm_edges(self.edge_embedding(h_E)))

        for layer in self.layers:
            h_V, h_E = layer(h_V, edge_index, h_E, batch_id)
        
        return h_V


class ESMFeatureExtractor:
    """Enhanced ESM feature extractor with support for different models"""
    
    def __init__(self, model_name='esm2_t12_35M_UR50D', device='cuda', use_finetuned=False, checkpoint_path=None):
        self.device = device
        self.model_name = model_name
        self.use_finetuned = use_finetuned
        
        if use_finetuned and checkpoint_path:
            self.model = self.load_finetuned_model(checkpoint_path)
        else:
            self.model, self.alphabet = self._load_pretrained_model(model_name)
            self.batch_converter = self.alphabet.get_batch_converter()
        
        self.model = self.model.to(device).eval()
        print(f"Loaded ESM model: {model_name} {'(fine-tuned)' if use_finetuned else '(pretrained)'}")
    
    def _load_pretrained_model(self, model_name):
        """Load pretrained ESM model"""
        if model_name == 'facebook/esm1v_t33_650M_UR50D':
            return esm.pretrained.esm1v_t33_650M_UR90S_1()
        elif model_name == 'facebook/esm2_t12_35M_UR50D':
            return esm.pretrained.esm2_t12_35M_UR50D()
        elif model_name == 'esm2_t30_150M_UR50D':
            return esm.pretrained.esm2_t30_150M_UR50D()
        else:
            raise ValueError(f"Unknown ESM model: {model_name}")
    
    def load_finetuned_model(self, checkpoint_path):
        """Load fine-tuned ESM model"""
        print(f"Loading fine-tuned model from {checkpoint_path}")
        checkpoint = torch.load(checkpoint_path, map_location=self.device)
        model, alphabet = self._load_pretrained_model(self.model_name)
        return model
    
    def extract_features(self, sequences, protein_ids, layer_idx=None):
        """Extract per-residue ESM features for a list of sequences"""
        sequences = [replace_noncanonical(seq, 'X') for seq in sequences]
        data = [(protein_ids[i], sequences[i]) for i in range(len(sequences))]
        
        if layer_idx is None:
            layer_idx = self.model.num_layers
        
        with torch.no_grad():
            batch_labels, batch_strs, batch_tokens = self.batch_converter(data)
            batch_tokens = batch_tokens.to(device=self.device, non_blocking=True)
            
            results = self.model(batch_tokens, repr_layers=[layer_idx], 
                               return_contacts=False)
            embeddings = results["representations"][layer_idx]
            
            sequence_embeddings = []
            for i, seq in enumerate(sequences):
                seq_len = len(seq)
                # Return per-residue embeddings [L, d_ESM] instead of averaging
                seq_repr = embeddings[i, 1:seq_len+1]  # [L, d_ESM]
                sequence_embeddings.append(seq_repr.cpu())
        
        return sequence_embeddings


class ESM_GNN_Model(nn.Module): 
    def __init__(self, hidden_dim, num_layers, dropout, device, num_heads=4, 
                 esm_model='esm2_t12_35M_UR50D', use_finetuned=False, checkpoint_path=None):
        super(ESM_GNN_Model, self).__init__()
        self.device = device
        self.hidden_dim = hidden_dim
        self.num_heads = num_heads
        
        self.esm_extractor = ESMFeatureExtractor(
            model_name=esm_model, 
            device=device, 
            use_finetuned=use_finetuned,
            checkpoint_path=checkpoint_path
        )
        
        if 'esm1v' in esm_model:
            esm_dim = 1280
        elif 'esm2_t12' in esm_model:
            esm_dim = 480
        elif 'esm2_t30' in esm_model:
            esm_dim = 640
        else:
            esm_dim = 480
        
        self.Graph_encoder = Graph_encoder(
            node_in_dim=esm_dim,      # No fake geometry, just ESM embeddings
            edge_in_dim=5,            # Sequence-based edge features: [rel_dist/3, sign, 1hop, 2hop, 3hop]
            hidden_dim=hidden_dim, 
            num_layers=num_layers, 
            drop_rate=dropout,
            num_heads=num_heads
        ).to(device)
        
        self.attention_pool = GlobalAttention(
            nn.Sequential(
                nn.Linear(hidden_dim, hidden_dim // 2),
                nn.BatchNorm1d(hidden_dim // 2),
                nn.ReLU(),
                nn.Dropout(dropout),
                nn.Linear(hidden_dim // 2, 1)
            )
        ).to(device)
        
        self.regressor = nn.Sequential(
            nn.Linear(hidden_dim, hidden_dim // 2),
            nn.BatchNorm1d(hidden_dim // 2),
            nn.ReLU(),
            nn.Dropout(dropout),
            
            nn.Linear(hidden_dim // 2, hidden_dim // 4),
            nn.BatchNorm1d(hidden_dim // 4),
            nn.ReLU(),
            nn.Dropout(dropout),
            
            nn.Linear(hidden_dim // 4, 1)
        ).to(device)

        self._initialize_weights()

    def _initialize_weights(self):
        for m in self.modules():
            if isinstance(m, nn.Linear):
                nn.init.xavier_uniform_(m.weight)
                if m.bias is not None:
                    nn.init.constant_(m.bias, 0)
            elif isinstance(m, nn.BatchNorm1d):
                nn.init.constant_(m.bias, 0)
                nn.init.constant_(m.weight, 1.0)

    def get_ESM_embeddings(self, accs, seqs):
        """Get per-residue ESM embeddings using the feature extractor"""
        embeddings = self.esm_extractor.extract_features(seqs, accs)
        # Return list of tensors, each with shape [L, d_ESM]
        return [torch.tensor(emb, device=self.device) for emb in embeddings]

    def forward(self, accs, seqs):
        # Get per-residue ESM embeddings for all sequences
        esm_embeddings = self.get_ESM_embeddings(accs, seqs)
        
        # Create graphs with per-residue embeddings and sequence-based edge features
        batch_data = []
        for i, seq in enumerate(seqs):
            seq_emb = esm_embeddings[i]  # [L, d_ESM] - already per-residue
            graph_data = create_graph_from_sequence(seq, seq_emb, self.device)
            batch_data.append(graph_data)
        
        batch = torch_geometric.data.Batch.from_data_list(batch_data)
        batch = batch.to(self.device)
        
        # Use ESM embeddings directly (no fake geometry)
        h_V = batch.x              # [sum_L, d_ESM]
        h_E = batch.edge_attr      # [num_edges, 5]
        
        # GNN encoding
        h_V = self.Graph_encoder(h_V, batch.edge_index, h_E, batch.batch)
        
        # Global pooling
        h_V_pooled = self.attention_pool(h_V, batch.batch)
        
        # Regression
        output = self.regressor(h_V_pooled)
        output = output.squeeze(-1)
        
        return output, h_V_pooled


