def augment_sequence(seq, mask_prob=0.15):
    seq_list = list(seq)
    for i in range(len(seq_list)):
        if random.random() < mask_prob:
            seq_list[i] = 'X'  # mask token
    return ''.join(seq_list)

def random_substitution(seq, sub_prob=0.1):
    amino_acids = 'ACDEFGHIKLMNPQRSTVWY'
    seq_list = list(seq)
    for i in range(len(seq_list)):
        if random.random() < sub_prob and seq_list[i] != 'X':
            seq_list[i] = random.choice(amino_acids)
    return ''.join(seq_list)

def sequence_cropping(seq, crop_ratio=0.9):
    if len(seq) < 50:
        return seq
    
    crop_len = int(len(seq) * crop_ratio)
    if crop_len >= len(seq):
        return seq
    
    start_idx = random.randint(0, len(seq) - crop_len)
    return seq[start_idx:start_idx + crop_len]


class ProteinDataset(Dataset):
    def __init__(self, csv_path, fasta_path, target_column, sequence_column, 
                 augment=False, mask_prob=0.15, sub_prob=0.1, crop_prob=0.0):
        self.data = pd.read_csv(csv_path)
        self.fasta_dict = self.read_fasta(fasta_path)
        self.target_column = target_column
        self.sequence_column = sequence_column
        
        # Augmentation parameters
        self.augment = augment
        self.mask_prob = mask_prob
        self.sub_prob = sub_prob
        self.crop_prob = crop_prob
        
        self.data = self.data[self.data[sequence_column].isin(self.fasta_dict.values())].reset_index(drop=True)
        print(f"Loaded {len(self.data)} samples from {csv_path}")
        if augment:
            print(f"  Augmentation enabled: mask_prob={mask_prob}, sub_prob={sub_prob}, crop_prob={crop_prob}")
    
    def read_fasta(self, fasta_path):
        fasta_dict = {}
        with open(fasta_path, 'r') as f:
            header = None
            for line in f:
                if line.startswith('>'):
                    header = line.strip()[1:].split()[0]
                    fasta_dict[header] = ''
                else:
                    if header:
                        fasta_dict[header] += line.strip()
        return fasta_dict
    
    def __len__(self):
        return len(self.data)
    
    def __getitem__(self, idx):
        row = self.data.iloc[idx]
        sequence = row[self.sequence_column]
        target = float(row[self.target_column])
        
        # Apply augmentations if enabled
        if self.augment:
            # Random masking
            if self.mask_prob > 0 and random.random() < 0.5:  # 50% chance to apply masking
                sequence = augment_sequence(sequence, self.mask_prob)
            
            # Random substitution
            if self.sub_prob > 0 and random.random() < 0.3:  # 30% chance to apply substitution
                sequence = random_substitution(sequence, self.sub_prob)
            
            # Sequence cropping
            if self.crop_prob > 0 and random.random() < self.crop_prob:
                sequence = sequence_cropping(sequence, crop_ratio=0.9)
        
        acc = None
        for k, v in self.fasta_dict.items():
            if v == row[self.sequence_column]:  # Use original sequence for matching
                acc = k
                break
        
        if acc is None:
            acc = f"seq_{idx}"
        
        return acc, sequence, target


def collate_fn(batch):
    accs, seqs, targets = zip(*batch)
    targets = torch.tensor(targets, dtype=torch.float32)
    return list(accs), list(seqs), targets


