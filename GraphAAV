def run_training_loop(model, train_loader, val_loader, args, device, save_dir=None):
    """Shared epoch loop (train + validate + early stopping + checkpointing).

    Used by both train_mode() and all_in_one_mode() so the loop only lives
    in one place instead of being duplicated across the two modes.
    """
    if save_dir is None:
        save_dir = args.save_dir

    criterion = nn.MSELoss()
    optimizer = optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.weight_decay)
    scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='min',
                                                    factor=0.7, patience=10)

    best_val_loss = float('inf')
    patience_counter = 0
    best_epoch = 0

    history = {
        'train_loss': [], 'val_loss': [],
        'train_r2': [], 'val_r2': [],
        'train_mae': [], 'val_mae': [],
        'lr': []
    }

    print(f"Training for {args.min_epoch}-{args.max_epoch} epochs with patience {args.patience}")

    for epoch in range(args.max_epoch):
        current_lr = optimizer.param_groups[0]['lr']
        print(f"\nEpoch {epoch+1}/{args.max_epoch} (LR: {current_lr:.2e})")

        # --- Train ---
        model.train()
        total_loss, predictions, targets = 0, [], []
        pbar = tqdm.tqdm(train_loader, desc="Training")
        for accs, seqs, batch_targets in pbar:
            batch_targets = batch_targets.to(device)

            optimizer.zero_grad()
            pred, _ = model(accs, seqs)

            loss = criterion(pred, batch_targets)
            loss.backward()
            optimizer.step()

            total_loss += loss.item()
            predictions.extend(pred.detach().cpu().numpy())
            targets.extend(batch_targets.cpu().numpy())

            pbar.set_postfix({'loss': f'{loss.item():.4f}'})

        train_loss = total_loss / len(train_loader)
        train_r2 = r2_score(targets, predictions)
        train_mae = mean_absolute_error(targets, predictions)

        # --- Validate ---
        model.eval()
        total_loss, predictions, targets = 0, [], []
        with torch.no_grad():
            pbar = tqdm.tqdm(val_loader, desc="Validation")
            for accs, seqs, batch_targets in pbar:
                batch_targets = batch_targets.to(device)

                pred, _ = model(accs, seqs)
                loss = criterion(pred, batch_targets)

                total_loss += loss.item()
                predictions.extend(pred.cpu().numpy())
                targets.extend(batch_targets.cpu().numpy())

                pbar.set_postfix({'loss': f'{loss.item():.4f}'})

        val_loss = total_loss / len(val_loader)
        val_r2 = r2_score(targets, predictions)
        val_mae = mean_absolute_error(targets, predictions)

        scheduler.step(val_loss)

        history['train_loss'].append(train_loss)
        history['val_loss'].append(val_loss)
        history['train_r2'].append(train_r2)
        history['val_r2'].append(val_r2)
        history['train_mae'].append(train_mae)
        history['val_mae'].append(val_mae)
        history['lr'].append(current_lr)

        print(f"Train - Loss: {train_loss:.4f}, R2: {train_r2:.4f}, MAE: {train_mae:.4f}")
        print(f"Val   - Loss: {val_loss:.4f}, R2: {val_r2:.4f}, MAE: {val_mae:.4f}")

        if val_loss < best_val_loss:
            best_val_loss = val_loss
            best_epoch = epoch
            torch.save({
                'epoch': epoch,
                'model_state_dict': model.state_dict(),
                'optimizer_state_dict': optimizer.state_dict(),
                'train_loss': train_loss,
                'val_loss': val_loss,
                'train_r2': train_r2,
                'val_r2': val_r2,
                'args': args
            }, f'{save_dir}/best_model.pt')
            patience_counter = 0
            print(f"New best model saved! Val Loss: {val_loss:.4f}")
        else:
            patience_counter += 1

        if epoch + 1 >= args.min_epoch:
            if patience_counter >= args.patience:
                print(f"Early stopping triggered after {epoch+1} epochs")
                break
        else:
            print(f"Min epoch not reached ({epoch+1}/{args.min_epoch}), continuing training...")

    return history, best_epoch, best_val_loss


def train_mode(args):
    """Standard training mode"""
    print("=== TRAINING MODE ===")
    print(f"Training configuration:")
    print(f"  Min epochs: {args.min_epoch}")
    print(f"  Max epochs: {args.max_epoch}")
    print(f"  Patience: {args.patience}")
    print(f"  ESM model: {args.esm_model}")
    
    os.makedirs(args.save_dir, exist_ok=True)
    
    print("Loading datasets...")
    train_dataset = ProteinDataset(args.train_csv, args.fasta_path, args.target_column, args.sequence_column)
    val_dataset = ProteinDataset(args.val_csv, args.fasta_path, args.target_column, args.sequence_column)
    test_dataset = ProteinDataset(args.test_csv, args.fasta_path, args.target_column, args.sequence_column)
    
    train_loader = DataLoader(train_dataset, batch_size=args.batch_size, 
                             shuffle=True, collate_fn=collate_fn)
    val_loader = DataLoader(val_dataset, batch_size=args.batch_size,
                           shuffle=False, collate_fn=collate_fn)
    test_loader = DataLoader(test_dataset, batch_size=args.batch_size,
                            shuffle=False, collate_fn=collate_fn)
    
    device = 'cuda' if torch.cuda.is_available() else 'cpu'
    print(f"Using device: {device}")
    
    model = ESM_GNN_Model(
        hidden_dim=args.hidden_dim, 
        num_layers=args.num_layers, 
        dropout=args.dropout, 
        device=device, 
        num_heads=args.num_heads,
        esm_model=args.esm_model,
        use_finetuned=args.use_finetuned,
        checkpoint_path=args.finetuned_checkpoint
    )
    model = model.to(device)
    
    print("Starting training...")
    history, best_epoch, best_val_loss = run_training_loop(model, train_loader, val_loader, args, device)
    
    # Save training history
    print("\nSaving training history...")
    save_training_history(history['train_loss'], history['val_loss'],
                         history['train_r2'], history['val_r2'],
                         history['train_mae'], history['val_mae'], args.save_dir)
    
    # Load best model for testing
    print("\nLoading best model for testing...")
    checkpoint = torch.load(f'{args.save_dir}/best_model.pt', map_location=device)
    model.load_state_dict(checkpoint['model_state_dict'])
    
    # Get final predictions
    print("Getting final predictions...")
    model.eval()
    
    def get_predictions_with_info(dataloader):
        all_preds, all_targets, all_embeddings, all_accs, all_seqs = [], [], [], [], []
        
        with torch.no_grad():
            for accs, seqs, targets in dataloader:
                targets = targets.to(device)
                pred, embeddings = model(accs, seqs)
                
                all_preds.extend(pred.cpu().numpy())
                all_targets.extend(targets.cpu().numpy())
                all_embeddings.append(embeddings.cpu().numpy())
                all_accs.extend(accs)
                all_seqs.extend(seqs)
        
        return all_preds, all_targets, np.vstack(all_embeddings), all_accs, all_seqs
    
    train_preds, train_targets, train_embeddings, train_accs, train_seqs = get_predictions_with_info(train_loader)
    val_preds, val_targets, val_embeddings, val_accs, val_seqs = get_predictions_with_info(val_loader)
    test_preds, test_targets, test_embeddings, test_accs, test_seqs = get_predictions_with_info(test_loader)
    
    # Save test predictions with embeddings
    print("\nSaving test predictions with embeddings...")
    save_test_predictions_to_csv(
        test_accs, test_seqs, test_targets, test_preds,
        embeddings=test_embeddings,
        save_path=args.save_dir,
        filename="test_prediction.csv",
        include_embeddings=True
    )
    
    # Create visualizations
    print("Creating visualizations...")
    
    plot_training_curves(history['train_loss'], history['val_loss'],
                        history['train_r2'], history['val_r2'],
                        history['lr'], args.save_dir)
    
    test_metrics = create_parity_plot(test_targets, test_preds, args.save_dir, 
                                 experiment_name="ESM-GNN Test Set")
    
    # Save final metrics and predictions
    final_metrics = {
        'Train': {'R2': r2_score(train_targets, train_preds), 'RMSE': np.sqrt(mean_squared_error(train_targets, train_preds))},
        'Validation': {'R2': r2_score(val_targets, val_preds), 'RMSE': np.sqrt(mean_squared_error(val_targets, val_preds))},
        'Test': {'R2': r2_score(test_targets, test_preds), 'RMSE': np.sqrt(mean_squared_error(test_targets, test_preds))}
    }
    
    print("\n" + "="*60)
    print("FINAL RESULTS SUMMARY")
    print("="*60)
    for dataset, metrics in final_metrics.items():
        print(f"{dataset:>12}: R2 = {metrics['R2']:.4f}, RMSE = {metrics['RMSE']:.4f}")
    print("="*60)
    
    print(f"\nTraining completed! Results saved to {args.save_dir}")
    print(f"  - Best model: best_model.pt")
    print(f"  - Training history: training_history.csv")
    print(f"  - Test predictions: test_prediction.csv")
    print(f"  - Training curves: training_curves.png")
    print(f"  - Parity plot: parity_plot_with_density.png")


def save_training_history(train_losses, val_losses, train_r2s, val_r2s, 
                          train_maes, val_maes, save_dir, filename="training_history.csv"):
    # Create training history DataFrame
    max_len = max(len(train_losses), len(val_losses))
    
    history_data = {
        'epoch': list(range(1, max_len + 1)),
        'train_loss': train_losses + [None] * (max_len - len(train_losses)),
        'val_loss': val_losses + [None] * (max_len - len(val_losses)),
        'train_r2': train_r2s + [None] * (max_len - len(train_r2s)),
        'val_r2': val_r2s + [None] * (max_len - len(val_r2s)),
        'train_mae': train_maes + [None] * (max_len - len(train_maes)),
        'val_mae': val_maes + [None] * (max_len - len(val_maes))
    }
    
    history_df = pd.DataFrame(history_data)
    
    # Save to CSV
    os.makedirs(save_dir, exist_ok=True)
    full_path = os.path.join(save_dir, filename)
    history_df.to_csv(full_path, index=False)
    
    print(f"Training history saved to: {full_path}")
    
    return history_df, full_path


def save_test_predictions_to_csv(accs, seqs, true_values, predicted_values, 
                                embeddings=None, save_path=None, 
                                filename="test_prediction.csv",
                                include_embeddings=False):
    # Create base dataframe
    data = {
        'protein_id': accs,
        'sequence': seqs,
        'true_value': true_values,
        'predicted_value': predicted_values,
        'sequence_length': [len(seq) for seq in seqs],
        'prediction_error': np.array(predicted_values) - np.array(true_values),
        'absolute_error': np.abs(np.array(predicted_values) - np.array(true_values))
    }
    
    # Add embeddings if requested and available
    if include_embeddings and embeddings is not None:
        print(f"Adding embeddings to CSV (shape: {embeddings.shape})")
        # embeddings should be [batch_size, embedding_dim]
        for i in range(embeddings.shape[1]):
            data[f'embedding_{i}'] = embeddings[:, i]
    
    # Create DataFrame
    df = pd.DataFrame(data)
    
    # Calculate additional metrics
    df['squared_error'] = df['prediction_error'] ** 2
    
    # Save to CSV
    if save_path:
        os.makedirs(save_path, exist_ok=True)
        full_path = os.path.join(save_path, filename)
    else:
        full_path = filename
    
    df.to_csv(full_path, index=False)
    
    # Print summary statistics
    print(f"\n=== Test Predictions Summary ===")
    print(f"Saved {len(df)} predictions to: {full_path}")
    print(f"MAE: {df['absolute_error'].mean():.4f}")
    print(f"RMSE: {np.sqrt(df['squared_error'].mean()):.4f}")
    print(f"R2: {r2_score(df['true_value'], df['predicted_value']):.4f}")
    print(f"Mean true value: {df['true_value'].mean():.4f}")
    print(f"Mean predicted value: {df['predicted_value'].mean():.4f}")
    print("===============================\n")
    
    return df


def all_in_one_mode(args):
    """Execute everything in one go"""
    
    print("\n" + "="*60)
    print("ALL-IN-ONE MODE: TRAINING + REPRESENTATION EXTRACTION")
    print("="*60)
    
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"Using device: {device}")
    
    os.makedirs(args.save_dir, exist_ok=True)
    
    filename_prefix = f"heads_{args.num_heads}_layers_{args.num_layers}_hidden_{args.hidden_dim}"
    
    # STEP 1: LOAD DATASETS
    print("\n" + "="*60)
    print("STEP 1: LOADING DATASETS")
    print("="*60)
    
    train_dataset = ProteinDataset(args.train_csv, args.fasta_path, 
                                  args.target_column, args.sequence_column)
    val_dataset = ProteinDataset(args.val_csv, args.fasta_path, 
                                args.target_column, args.sequence_column)
    test_dataset = ProteinDataset(args.test_csv, args.fasta_path, 
                                 args.target_column, args.sequence_column)
    
    train_loader = DataLoader(train_dataset, batch_size=args.batch_size, 
                             shuffle=True, collate_fn=collate_fn)
    val_loader = DataLoader(val_dataset, batch_size=args.batch_size,
                           shuffle=False, collate_fn=collate_fn)
    test_loader = DataLoader(test_dataset, batch_size=args.batch_size,
                            shuffle=False, collate_fn=collate_fn)
    
    train_loader_noshuffle = DataLoader(train_dataset, batch_size=args.batch_size, 
                                        shuffle=False, collate_fn=collate_fn)
    
    print(f"Loaded datasets:")
    print(f"   Train: {len(train_dataset)} samples")
    print(f"   Val: {len(val_dataset)} samples")
    print(f"   Test: {len(test_dataset)} samples")
    
    # STEP 2: EXTRACT PRE-TRAINING REPRESENTATIONS
    print("\n" + "="*60)
    print("STEP 2: EXTRACTING PRE-TRAINING REPRESENTATIONS")
    print("="*60)
    
    model = ESM_GNN_Model(
        hidden_dim=args.hidden_dim,
        num_layers=args.num_layers,
        dropout=args.dropout,
        device=device,
        num_heads=args.num_heads,
        esm_model=args.esm_model,
        use_finetuned=args.use_finetuned,
        checkpoint_path=args.finetuned_checkpoint
    ).to(device)
    
    print("\nExtracting initial ESM embeddings...")
    initial_representations = extract_initial_esm_embeddings(
        model, train_loader_noshuffle, val_loader, test_loader, device
    )
    
    initial_csv_path = os.path.join(
        args.save_dir, 
        f"esm_representations_{filename_prefix}.csv"
    )
    save_representations_to_csv(initial_representations, initial_csv_path, 
                               representation_type='initial_input')
    print(f"Saved ESM representations: {initial_csv_path}")
    
    print("\nExtracting pre-training GNN representations...")
    pre_training_representations = extract_gnn_representations(
        model, train_loader_noshuffle, val_loader, test_loader, device, "pre-training"
    )
    
    pre_training_csv_path = os.path.join(
        args.save_dir,
        f"gnn_representations_{filename_prefix}_pre_training.csv"
    )
    save_representations_to_csv(pre_training_representations, pre_training_csv_path,
                               representation_type='gnn_output')
    print(f"Saved pre-training GNN representations: {pre_training_csv_path}")
    
    # STEP 3: TRAIN MODEL
    print("\n" + "="*60)
    print("STEP 3: TRAINING MODEL")
    print("="*60)
    
    history, best_epoch, best_val_loss = run_training_loop(model, train_loader, val_loader, args, device)
    
    # STEP 4: EXTRACT POST-TRAINING REPRESENTATIONS
    print("\n" + "="*60)
    print("STEP 4: EXTRACTING POST-TRAINING REPRESENTATIONS")
    print("="*60)
    
    checkpoint = torch.load(f'{args.save_dir}/best_model.pt', map_location=device)
    model.load_state_dict(checkpoint['model_state_dict'])
    print(f"Loaded best model from epoch {checkpoint['epoch']+1}")
    
    print("\nExtracting post-training GNN representations...")
    post_training_representations = extract_gnn_representations(
        model, train_loader_noshuffle, val_loader, test_loader, device, "post-training"
    )
    
    post_training_csv_path = os.path.join(
        args.save_dir,
        f"gnn_representations_{filename_prefix}_post_training.csv"
    )
    save_representations_to_csv(post_training_representations, post_training_csv_path,
                               representation_type='gnn_output')
    print(f"Saved post-training GNN representations: {post_training_csv_path}")
    
    # STEP 5: CREATE VISUALIZATIONS
    print("\n" + "="*60)
    print("STEP 5: CREATING VISUALIZATIONS & FINAL ANALYSIS")
    print("="*60)
    
    # Reuse the test-set predictions/targets already computed in STEP 4
    # instead of re-running a full forward pass over the test set again.
    test_mask = np.array([label == 'test' for label in post_training_representations['dataset_labels']])
    test_preds = post_training_representations['predictions'][test_mask]
    test_targets = post_training_representations['targets'][test_mask]
    
    plot_training_curves(history['train_loss'], history['val_loss'],
                        history['train_r2'], history['val_r2'],
                        history['lr'], args.save_dir)
    
    test_metrics = create_parity_plot(test_targets, test_preds, args.save_dir, 
                                     experiment_name="ESM-GNN Test Set")
    
    if args.compare_representations:
        comparison_dir = os.path.join(args.save_dir, 'representation_comparison')
        os.makedirs(comparison_dir, exist_ok=True)
        
        create_representation_comparison_plots(
            initial_representations,
            pre_training_representations,
            post_training_representations,
            comparison_dir,
            filename_prefix
        )
        print(f"Comparison plots saved to: {comparison_dir}")
    
    # STEP 6: FINAL SUMMARY
    print("\n" + "="*60)
    print("FINAL RESULTS SUMMARY")
    print("="*60)
    
    for split_name in ['train', 'validation', 'test']:
        post_mask = np.array([label == split_name for label in post_training_representations['dataset_labels']])
        
        if post_mask.any():
            split_targets = post_training_representations['targets'][post_mask]
            split_preds = post_training_representations['predictions'][post_mask]
            
            split_r2 = r2_score(split_targets, split_preds)
            split_rmse = np.sqrt(mean_squared_error(split_targets, split_preds))
            split_mae = mean_absolute_error(split_targets, split_preds)
            
            print(f"\n{split_name.upper()} SET:")
            print(f"  R2:   {split_r2:.4f}")
            print(f"  RMSE: {split_rmse:.4f}")
            print(f"  MAE:  {split_mae:.4f}")
    
    print("\n" + "="*60)
    print("ALL-IN-ONE EXECUTION COMPLETE!")
    print("="*60)
    
    print("\nOutput files created:")
    print(f"  1. Model: {args.save_dir}/best_model.pt")
    print(f"  2. ESM embeddings: {initial_csv_path}")
    print(f"  3. Pre-training GNN: {pre_training_csv_path}")
    print(f"  4. Post-training GNN: {post_training_csv_path}")
    print(f"  5. Training curves: {args.save_dir}/training_curves.png")
    print(f"  6. Parity plot: {args.save_dir}/parity_plot.png")
    if args.compare_representations:
        print(f"  7. Comparison plots: {comparison_dir}/")
    
    return {
        'best_epoch': checkpoint['epoch'] + 1,
        'best_val_loss': checkpoint['val_loss'],
        'best_val_r2': checkpoint['val_r2'],
        'test_metrics': test_metrics
    }


def main():
    args = parse_arguments()
    
    if args.mode == 'all':
        # Execute everything at once
        results = all_in_one_mode(args)
        print(f"\nAll tasks completed successfully!")
        print(f"   Best model: Epoch {results['best_epoch']}")
        print(f"   Best Val R2: {results['best_val_r2']:.4f}")
        print(f"   Test R2: {results['test_metrics']['r2']:.4f}")
        
    elif args.mode == 'train':
        # Original training mode
        train_mode(args)
            
    else:
        raise ValueError(f"Unknown mode: {args.mode}")


if __name__ == '__main__':
    main()
