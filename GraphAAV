# Per-residue embedding size and final representation layer of each supported
# encoder. Keeping the loader name, the width and the layer index in one place
# avoids the three-way mismatch that arises when they are hard-coded separately.
ESM_MODELS = {
    "esm1v_t33_650M_UR90S_1": {"embed_dim": 1280, "repr_layer": 33},
    "esm2_t12_35M_UR50D": {"embed_dim": 480, "repr_layer": 12},
    "esm2_t30_150M_UR50D": {"embed_dim": 640, "repr_layer": 30},
}

# Residues are connected to neighbours within this window (manuscript Eq. 4).
EDGE_WINDOW = 3
EDGE_FEATURE_DIM = 5


def parse_arguments():
    parser = argparse.ArgumentParser(
        description="Train GraphAAV for AAV capsid property prediction"
    )

    parser.add_argument("--mode", type=str, default="train", choices=["train", "all"],
                        help="'train' trains and evaluates; 'all' additionally "
                             "extracts ESM/GNN representations before and after training")

    # Data
    parser.add_argument("--train_csv", type=str, default="data/train.csv")
    parser.add_argument("--val_csv", type=str, default="data/valid.csv")
    parser.add_argument("--test_csv", type=str, default="data/test.csv")
    parser.add_argument("--fasta_path", type=str, default="data/sequences.fasta",
                        help="FASTA of full-length capsid sequences")
    parser.add_argument("--target_column", type=str, default="production_fitness",
                        help="Regression target column in the CSV files")
    parser.add_argument("--sequence_column", type=str, default="full_sequence")

    # Optimisation
    parser.add_argument("--batch_size", type=int, default=64)
    parser.add_argument("--min_epoch", type=int, default=80,
                        help="Early stopping is only considered after this epoch")
    parser.add_argument("--max_epoch", type=int, default=400)
    parser.add_argument("--lr", type=float, default=5e-5)
    parser.add_argument("--weight_decay", type=float, default=5e-5)
    parser.add_argument("--patience", type=int, default=15,
                        help="Early stopping patience")
    parser.add_argument("--lr_factor", type=float, default=0.7,
                        help="ReduceLROnPlateau decay factor")
    parser.add_argument("--lr_patience", type=int, default=10,
                        help="ReduceLROnPlateau patience")
    parser.add_argument("--seed", type=int, default=42)

    # Architecture
    parser.add_argument("--hidden_dim", type=int, default=256)
    parser.add_argument("--num_layers", type=int, default=4)
    parser.add_argument("--dropout", type=float, default=0.0)
    parser.add_argument("--num_heads", type=int, default=4)
    parser.add_argument("--esm_model", type=str, default="esm2_t12_35M_UR50D",
                        choices=sorted(ESM_MODELS))

    # Outputs
    parser.add_argument("--save_dir", type=str, default="results/graphaav")
    parser.add_argument("--extract_attention", action="store_true",
                        help="Write per-residue attention scores for the test set")
    parser.add_argument("--compare_representations", action="store_true",
                        help="Plot PCA / performance comparison of representations "
                             "(requires --mode all)")

    args = parser.parse_args()
    if args.min_epoch > args.max_epoch:
        raise ValueError(
            f"min_epoch ({args.min_epoch}) cannot exceed max_epoch ({args.max_epoch})"
        )
    if args.hidden_dim % args.num_heads != 0:
        raise ValueError("hidden_dim must be divisible by num_heads")
    return args


# ---------------------------------------------------------------------------
# Graph construction
# ---------------------------------------------------------------------------

def create_graph_from_sequence(sequence, node_embeddings, device):
    """Build the sequence-local graph for one variant.

    Args:
        sequence: capsid sequence (length L).
        node_embeddings: per-residue embeddings, shape ``[L, d]``.
        device: device on which to allocate the graph tensors.

    Returns:
        ``Data`` with ``x=[L, d]``, ``edge_index`` and ``edge_attr=[E, 5]``,
        where each edge feature is
        ``[|i-j|/3, sign(j-i), 1{|i-j|=1}, 1{|i-j|=2}, 1{|i-j|=3}]``.
    """
    length = len(sequence)
    src, dst, edge_feat = [], [], []

    for i in range(length):
        for j in range(max(0, i - EDGE_WINDOW), min(length, i + EDGE_WINDOW + 1)):
            if i == j:
                continue
            src.append(i)
            dst.append(j)
            offset = abs(i - j)
            edge_feat.append([
                offset / EDGE_WINDOW,
                1.0 if j > i else -1.0,
                float(offset == 1),
                float(offset == 2),
                float(offset == 3),
            ])

    return torch_geometric.data.Data(
        x=node_embeddings.to(device),
        edge_index=torch.tensor([src, dst], device=device, dtype=torch.long),
        edge_attr=torch.tensor(edge_feat, device=device, dtype=torch.float),
    )


# ---------------------------------------------------------------------------
# Encoder blocks
# ---------------------------------------------------------------------------

class EdgeMLP(nn.Module):
    """Update each edge from its two endpoint node states."""

    def __init__(self, num_hidden, dropout=0.0):
        super().__init__()
        self.dropout = nn.Dropout(dropout)
        self.norm = nn.BatchNorm1d(num_hidden)
        self.W11 = nn.Linear(3 * num_hidden, num_hidden, bias=True)
        self.W12 = nn.Linear(num_hidden, num_hidden, bias=True)
        self.act = nn.GELU()

    def forward(self, h_V, edge_index, h_E):
        src_idx, dst_idx = edge_index[0], edge_index[1]
        h_EV = torch.cat([h_V[src_idx], h_E, h_V[dst_idx]], dim=-1)
        h_message = self.W12(self.act(self.W11(h_EV)))
        return self.norm(h_E + self.dropout(h_message))


class Context(nn.Module):
    """Gate node states by a graph-level context vector."""

    def __init__(self, num_hidden):
        super().__init__()
        self.V_MLP_g = nn.Sequential(
            nn.Linear(num_hidden, num_hidden),
            nn.ReLU(),
            nn.Linear(num_hidden, num_hidden),
            nn.Sigmoid(),
        )

    def forward(self, h_V, batch_id):
        c_V = scatter_mean(h_V, batch_id, dim=0)
        return h_V * self.V_MLP_g(c_V[batch_id])


class GNNLayer(nn.Module):
    """Edge-conditioned multi-head message passing with an edge update."""

    def __init__(self, num_hidden, dropout=0.0, num_heads=4):
        super().__init__()
        self.dropout = nn.Dropout(dropout)
        self.norm = nn.ModuleList([nn.BatchNorm1d(num_hidden) for _ in range(2)])
        self.attention = TransformerConv(
            in_channels=num_hidden,
            out_channels=num_hidden // num_heads,
            heads=num_heads,
            dropout=dropout,
            edge_dim=num_hidden,
            root_weight=False,
        )
        self.PositionWiseFeedForward = nn.Sequential(
            nn.Linear(num_hidden, num_hidden * 4),
            nn.ReLU(),
            nn.Linear(num_hidden * 4, num_hidden),
        )
        self.edge_update = EdgeMLP(num_hidden, dropout)
        self.context = Context(num_hidden)

    def forward(self, h_V, edge_index, h_E, batch_id):
        dh = self.attention(h_V, edge_index, h_E)
        h_V = self.norm[0](h_V + self.dropout(dh))

        dh = self.PositionWiseFeedForward(h_V)
        h_V = self.norm[1](h_V + self.dropout(dh))

        h_E = self.edge_update(h_V, edge_index, h_E)
        h_V = self.context(h_V, batch_id)
        return h_V, h_E


class GraphEncoder(nn.Module):
    """Input embeddings followed by a stack of :class:`GNNLayer` blocks."""

    def __init__(self, node_in_dim, edge_in_dim, hidden_dim,
                 num_layers=4, drop_rate=0.0, num_heads=4):
        super().__init__()
        self.node_embedding = nn.Linear(node_in_dim, hidden_dim, bias=True)
        self.edge_embedding = nn.Linear(edge_in_dim, hidden_dim, bias=True)
        self.norm_nodes = nn.BatchNorm1d(hidden_dim)
        self.norm_edges = nn.BatchNorm1d(hidden_dim)
        self.W_v = nn.Linear(hidden_dim, hidden_dim, bias=True)
        self.W_e = nn.Linear(hidden_dim, hidden_dim, bias=True)
        self.layers = nn.ModuleList([
            GNNLayer(num_hidden=hidden_dim, dropout=drop_rate, num_heads=num_heads)
            for _ in range(num_layers)
        ])

    def embed_inputs(self, h_V, h_E):
        h_V = self.W_v(self.norm_nodes(self.node_embedding(h_V)))
        h_E = self.W_e(self.norm_edges(self.edge_embedding(h_E)))
        return h_V, h_E

    def forward(self, h_V, edge_index, h_E, batch_id):
        h_V, h_E = self.embed_inputs(h_V, h_E)
        for layer in self.layers:
            h_V, h_E = layer(h_V, edge_index, h_E, batch_id)
        return h_V


# ---------------------------------------------------------------------------
# ESM feature extraction
# ---------------------------------------------------------------------------

class ESMFeatureExtractor:
    """Frozen protein language model producing per-residue embeddings.

    The encoder is deliberately held outside ``nn.Module`` registration so its
    weights are neither optimised nor written into GraphAAV checkpoints.
    """

    def __init__(self, model_name, device):
        if model_name not in ESM_MODELS:
            raise ValueError(
                f"Unknown ESM model '{model_name}'. "
                f"Available: {sorted(ESM_MODELS)}"
            )
        self.device = device
        self.model_name = model_name
        self.embed_dim = ESM_MODELS[model_name]["embed_dim"]
        self.repr_layer = ESM_MODELS[model_name]["repr_layer"]

        self.model, self.alphabet = getattr(esm.pretrained, model_name)()
        self.batch_converter = self.alphabet.get_batch_converter()
        self.model = self.model.to(device).eval()
        for param in self.model.parameters():
            param.requires_grad = False

        print(f"Loaded {model_name} (frozen, {self.embed_dim}-dim, "
              f"layer {self.repr_layer})")

    def extract(self, accs, seqs):
        """Return a list of ``[L, d]`` tensors, one per sequence."""
        seqs = [common.replace_noncanonical(seq) for seq in seqs]
        data = list(zip(accs, seqs))

        with torch.no_grad():
            _, _, tokens = self.batch_converter(data)
            tokens = tokens.to(self.device, non_blocking=True)
            out = self.model(tokens, repr_layers=[self.repr_layer],
                             return_contacts=False)
            reps = out["representations"][self.repr_layer]
            # Index 0 is the BOS token, so residue i sits at position i+1.
            return [reps[i, 1:len(seq) + 1] for i, seq in enumerate(seqs)]


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

class GraphAAV(nn.Module):
    def __init__(self, hidden_dim, num_layers, dropout, device, num_heads=4,
                 esm_model="esm2_t12_35M_UR50D"):
        super().__init__()
        self.device = device
        self.hidden_dim = hidden_dim
        self.num_heads = num_heads

        self.esm_extractor = ESMFeatureExtractor(esm_model, device)

        # Attribute names below are part of the checkpoint keys; renaming them
        # would invalidate previously trained best_model.pt files.
        self.Graph_encoder = GraphEncoder(
            node_in_dim=self.esm_extractor.embed_dim,
            edge_in_dim=EDGE_FEATURE_DIM,
            hidden_dim=hidden_dim,
            num_layers=num_layers,
            drop_rate=dropout,
            num_heads=num_heads,
        )
        self.attention_pool = GlobalAttention(
            nn.Sequential(
                nn.Linear(hidden_dim, hidden_dim // 2),
                nn.BatchNorm1d(hidden_dim // 2),
                nn.ReLU(),
                nn.Dropout(dropout),
                nn.Linear(hidden_dim // 2, 1),
            )
        )
        self.regressor = nn.Sequential(
            nn.Linear(hidden_dim, hidden_dim // 2),
            nn.BatchNorm1d(hidden_dim // 2),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(hidden_dim // 2, hidden_dim // 4),
            nn.BatchNorm1d(hidden_dim // 4),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(hidden_dim // 4, 1),
        )

        self._initialize_weights()
        self.to(device)

    def _initialize_weights(self):
        for module in self.modules():
            if isinstance(module, nn.Linear):
                nn.init.xavier_uniform_(module.weight)
                if module.bias is not None:
                    nn.init.constant_(module.bias, 0)
            elif isinstance(module, nn.BatchNorm1d):
                nn.init.constant_(module.bias, 0)
                nn.init.constant_(module.weight, 1.0)

    def build_batch(self, accs, seqs):
        embeddings = self.esm_extractor.extract(accs, seqs)
        graphs = [
            create_graph_from_sequence(seq, emb, self.device)
            for seq, emb in zip(seqs, embeddings)
        ]
        return torch_geometric.data.Batch.from_data_list(graphs).to(self.device)

    def forward(self, accs, seqs):
        batch = self.build_batch(accs, seqs)
        h_V = self.Graph_encoder(batch.x, batch.edge_index, batch.edge_attr,
                                 batch.batch)
        pooled = self.attention_pool(h_V, batch.batch)
        return self.regressor(pooled).squeeze(-1), pooled


# ---------------------------------------------------------------------------
# Residue-level attention
# ---------------------------------------------------------------------------

@torch.no_grad()
def residue_attention_scores(model, acc, sequence):
    """Per-residue importance for one variant, min-max normalised to [0, 1].

    Combines the global attention-pooling gate with the mean magnitude of each
    layer's message, which is what the manuscript reports as residue-level
    interpretation.
    """
    model.eval()
    batch = model.build_batch([acc], [sequence])

    h_V, h_E = model.Graph_encoder.embed_inputs(batch.x, batch.edge_attr)
    layer_importance = []
    for layer in model.Graph_encoder.layers:
        dh = layer.attention(h_V, batch.edge_index, h_E)
        layer_importance.append(torch.norm(dh, dim=1))

        h_V = layer.norm[0](h_V + layer.dropout(dh))
        h_V = layer.norm[1](h_V + layer.dropout(layer.PositionWiseFeedForward(h_V)))
        h_E = layer.edge_update(h_V, batch.edge_index, h_E)
        h_V = layer.context(h_V, batch.batch)

    gate = torch.softmax(model.attention_pool.gate_nn(h_V), dim=0).squeeze(-1)
    scores = gate * torch.stack(layer_importance).mean(dim=0)
    scores = scores.cpu().numpy()

    spread = scores.max() - scores.min()
    if spread > 0:
        scores = (scores - scores.min()) / spread
    return scores


def extract_attention_table(model, loader, save_dir):
    """Write per-residue and per-sequence attention tables for a split."""
    os.makedirs(save_dir, exist_ok=True)
    residue_rows, sequence_rows = [], []

    for accs, seqs, _ in tqdm.tqdm(loader, desc="Extracting attention"):
        for acc, seq in zip(accs, seqs):
            scores = residue_attention_scores(model, acc, seq)
            for position, (residue, score) in enumerate(zip(seq, scores), start=1):
                residue_rows.append({
                    "protein_id": acc,
                    "position": position,
                    "residue": residue,
                    "attention_score": float(score),
                    "sequence_length": len(seq),
                })
            sequence_rows.append({
                "protein_id": acc,
                "sequence": seq,
                "sequence_length": len(seq),
                "mean_attention": float(scores.mean()),
                "max_attention": float(scores.max()),
                "std_attention": float(scores.std()),
            })

    residue_df = pd.DataFrame(residue_rows)
    sequence_df = pd.DataFrame(sequence_rows)
    residue_df.to_csv(os.path.join(save_dir, "attention_per_residue.csv"), index=False)
    sequence_df.to_csv(os.path.join(save_dir, "attention_per_sequence.csv"), index=False)
    print(f"Attention tables saved to: {save_dir}")
    return residue_df, sequence_df


