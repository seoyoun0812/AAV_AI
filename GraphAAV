# Representation extraction
# ---------------------------------------------------------------------------

@torch.no_grad()
def extract_representations(model, loaders, stage, use_gnn=True):
    """Collect sequence-level representations across all splits.

    Args:
        loaders: ``{split_name: DataLoader}``.
        stage: label recorded in the output (e.g. ``"post-training"``).
        use_gnn: if True use the pooled GNN output and record predictions;
            otherwise mean-pool the raw ESM embeddings.
    """
    model.eval()
    collected = {
        "embeddings": [], "predictions": [], "targets": [],
        "protein_ids": [], "sequences": [], "dataset_labels": [],
    }

    for split_name, loader in loaders.items():
        desc = f"{split_name} ({stage})"
        for accs, seqs, targets in tqdm.tqdm(loader, desc=desc):
            if use_gnn:
                predictions, pooled = model(accs, seqs)
                collected["embeddings"].append(pooled.cpu().numpy())
                collected["predictions"].extend(predictions.cpu().numpy())
            else:
                embeddings = model.esm_extractor.extract(accs, seqs)
                collected["embeddings"].append(
                    np.stack([emb.mean(dim=0).cpu().numpy() for emb in embeddings])
                )
            collected["targets"].extend(targets.numpy())
            collected["protein_ids"].extend(accs)
            collected["sequences"].extend(seqs)
            collected["dataset_labels"].extend([split_name] * len(accs))

    collected["embeddings"] = np.vstack(collected["embeddings"])
    collected["targets"] = np.asarray(collected["targets"])
    collected["predictions"] = (
        np.asarray(collected["predictions"]) if use_gnn else None
    )
    return collected


def save_representations(representations, csv_path):
    """Write representations (and predictions, when available) to CSV."""
    os.makedirs(os.path.dirname(csv_path) or ".", exist_ok=True)
    embeddings = representations["embeddings"]

    frame = {
        "protein_id": representations["protein_ids"],
        "dataset": representations["dataset_labels"],
        "target": representations["targets"],
    }
    if representations["predictions"] is not None:
        frame["prediction"] = representations["predictions"]
        frame["error"] = representations["predictions"] - representations["targets"]
    for i in range(embeddings.shape[1]):
        frame[f"dim_{i}"] = embeddings[:, i]

    df = pd.DataFrame(frame)
    df.to_csv(csv_path, index=False, float_format="%.6f")
    counts = df["dataset"].value_counts().to_dict()
    print(f"Saved {len(df)} rows x {embeddings.shape[1]} dims to {csv_path} "
          f"({counts})")
    return df


def plot_representation_comparison(initial, pre, post, output_dir, prefix):
    """PCA of each representation plus a pre/post R2 comparison."""
    os.makedirs(output_dir, exist_ok=True)

    fig, axes = plt.subplots(1, 3, figsize=(18, 6))
    for ax, (representation, title) in zip(axes, [
        (initial, "Initial ESM"),
        (pre, "Pre-training GNN"),
        (post, "Post-training GNN"),
    ]):
        pca = PCA(n_components=2)
        projected = pca.fit_transform(representation["embeddings"])
        scatter = ax.scatter(projected[:, 0], projected[:, 1],
                             c=representation["targets"], cmap="viridis",
                             alpha=0.6, s=20)
        explained = pca.explained_variance_ratio_
        ax.set_title(f"{title}\n(Var explained: {explained.sum():.2%})")
        ax.set_xlabel(f"PC1 ({explained[0]:.2%})")
        ax.set_ylabel(f"PC2 ({explained[1]:.2%})")
        plt.colorbar(scatter, ax=ax, label="Target value")

    plt.suptitle(f"PCA comparison of representations\n{prefix}", fontsize=14, y=1.02)
    plt.tight_layout()
    plt.savefig(os.path.join(output_dir, f"pca_comparison_{prefix}.png"),
                dpi=300, bbox_inches="tight")
    plt.close()

    splits = ["train", "val", "test"]
    fig, ax = plt.subplots(figsize=(10, 6))
    positions = np.arange(len(splits))
    width = 0.35

    for offset, representation, label, color in [
        (-width / 2, pre, "Pre-training", "lightcoral"),
        (width / 2, post, "Post-training", "lightgreen"),
    ]:
        scores = []
        labels = np.asarray(representation["dataset_labels"])
        for split in splits:
            mask = labels == split
            scores.append(
                common.regression_metrics(
                    representation["targets"][mask],
                    representation["predictions"][mask],
                )["r2"] if mask.any() else 0.0
            )
        bars = ax.bar(positions + offset, scores, width, label=label, color=color)
        for bar in bars:
            ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height(),
                    f"{bar.get_height():.3f}", ha="center", va="bottom")

    ax.set_xlabel("Dataset split")
    ax.set_ylabel("R2 score")
    ax.set_title(f"Model performance comparison\n{prefix}")
    ax.set_xticks(positions)
    ax.set_xticklabels(splits)
    ax.legend()
    plt.tight_layout()
    plt.savefig(os.path.join(output_dir, f"performance_comparison_{prefix}.png"), dpi=300)
    plt.close()
    print(f"Comparison plots saved to: {output_dir}")


# ---------------------------------------------------------------------------
# Training
# ---------------------------------------------------------------------------

def run_epoch(model, loader, criterion, device, optimizer=None, desc="Train"):
    """One pass over ``loader``; an optimizer switches on training behaviour."""
    is_train = optimizer is not None
    model.train(is_train)

    total_loss = 0.0
    predictions, targets = [], []

    progress = tqdm.tqdm(loader, desc=desc)
    with torch.set_grad_enabled(is_train):
        for accs, seqs, batch_targets in progress:
            batch_targets = batch_targets.to(device)

            if is_train:
                optimizer.zero_grad()
            pred, _ = model(accs, seqs)
            loss = criterion(pred, batch_targets)
            if is_train:
                loss.backward()
                optimizer.step()

            total_loss += loss.item()
            predictions.extend(pred.detach().cpu().numpy())
            targets.extend(batch_targets.cpu().numpy())
            progress.set_postfix({"loss": f"{loss.item():.4f}"})

    metrics = common.regression_metrics(targets, predictions)
    metrics["loss"] = total_loss / max(len(loader), 1)
    return metrics


@torch.no_grad()
def collect_predictions(model, loader, device):
    """Predictions, targets, pooled embeddings and identifiers for a split."""
    model.eval()
    preds, targets, embeddings, accs_all, seqs_all = [], [], [], [], []

    for accs, seqs, batch_targets in loader:
        pred, pooled = model(accs, seqs)
        preds.extend(pred.cpu().numpy())
        targets.extend(batch_targets.numpy())
        embeddings.append(pooled.cpu().numpy())
        accs_all.extend(accs)
        seqs_all.extend(seqs)

    return (np.asarray(preds), np.asarray(targets),
            np.vstack(embeddings), accs_all, seqs_all)


def train_model(model, train_loader, val_loader, args, device):
    """Train with ReduceLROnPlateau, checkpointing and delayed early stopping."""
    criterion = nn.MSELoss()
    optimizer = optim.AdamW(model.parameters(), lr=args.lr,
                            weight_decay=args.weight_decay)
    scheduler = optim.lr_scheduler.ReduceLROnPlateau(
        optimizer, mode="min", factor=args.lr_factor, patience=args.lr_patience
    )

    history = common.new_history()
    best_val_loss = float("inf")
    patience_counter = 0
    checkpoint_path = os.path.join(args.save_dir, "best_model.pt")

    print(f"Training for {args.min_epoch}-{args.max_epoch} epochs "
          f"(early stopping patience {args.patience})")

    for epoch in range(1, args.max_epoch + 1):
        current_lr = optimizer.param_groups[0]["lr"]
        print(f"\nEpoch {epoch}/{args.max_epoch} (LR: {current_lr:.2e})")

        train_metrics = run_epoch(model, train_loader, criterion, device,
                                  optimizer=optimizer, desc="Training")
        val_metrics = run_epoch(model, val_loader, criterion, device,
                                desc="Validation")
        scheduler.step(val_metrics["loss"])
        common.update_history(history, train_metrics, val_metrics, current_lr)

        print(f"Train - loss {train_metrics['loss']:.4f}, "
              f"R2 {train_metrics['r2']:.4f}, MAE {train_metrics['mae']:.4f}")
        print(f"Val   - loss {val_metrics['loss']:.4f}, "
              f"R2 {val_metrics['r2']:.4f}, MAE {val_metrics['mae']:.4f}")

        if val_metrics["loss"] < best_val_loss:
            best_val_loss = val_metrics["loss"]
            patience_counter = 0
            torch.save({
                "epoch": epoch,
                "model_state_dict": model.state_dict(),
                "optimizer_state_dict": optimizer.state_dict(),
                "train_metrics": train_metrics,
                "val_metrics": val_metrics,
                "args": vars(args),
            }, checkpoint_path)
            print(f"New best model saved (val loss {best_val_loss:.4f})")
        else:
            patience_counter += 1

        if epoch >= args.min_epoch and patience_counter >= args.patience:
            print(f"Early stopping after {epoch} epochs")
            break
        if epoch < args.min_epoch:
            print(f"Minimum epoch not reached ({epoch}/{args.min_epoch})")

    return history, checkpoint_path


def evaluate_and_report(model, loaders, args, device, history):
    """Restore the best checkpoint, then write metrics, plots and predictions."""
    checkpoint_path = os.path.join(args.save_dir, "best_model.pt")
    checkpoint = torch.load(checkpoint_path, map_location=device, weights_only=False)
    model.load_state_dict(checkpoint["model_state_dict"])
    print(f"\nLoaded best model from epoch {checkpoint['epoch']}")

    common.save_training_history(history, args.save_dir)
    common.plot_training_curves(history, args.save_dir, experiment_name="GraphAAV")

    all_metrics = {"best_epoch": checkpoint["epoch"]}
    test_preds = test_targets = None
    for split_name, loader in loaders.items():
        preds, targets, embeddings, accs, seqs = collect_predictions(
            model, loader, device
        )
        all_metrics[split_name] = common.regression_metrics(targets, preds)
        if split_name == "test":
            test_preds, test_targets = preds, targets
            common.save_predictions_csv(accs, seqs, targets, preds, args.save_dir,
                                        embeddings=embeddings)

    common.plot_parity(test_targets, test_preds, args.save_dir,
                       dataset_name="Test", experiment_name="GraphAAV")
    common.save_metrics_json(all_metrics, args.save_dir)

    print("\n" + "=" * 60)
    print("FINAL RESULTS")
    print("=" * 60)
    for split_name in loaders:
        print(common.format_metrics(split_name, all_metrics[split_name]))
    print("=" * 60)

    if args.extract_attention:
        extract_attention_table(
            model, loaders["test"], os.path.join(args.save_dir, "attention_analysis")
        )
    return all_metrics


def main():
    args = parse_arguments()
    common.set_seed(args.seed)
    device = common.get_device()
    os.makedirs(args.save_dir, exist_ok=True)

    print("=" * 60)
    print("GraphAAV")
    print("=" * 60)
    print(f"Mode          : {args.mode}")
    print(f"Target        : {args.target_column}")
    print(f"ESM encoder   : {args.esm_model}")
    print(f"Hidden / heads: {args.hidden_dim} / {args.num_heads}")
    print(f"Layers        : {args.num_layers}")
    print(f"Batch / LR    : {args.batch_size} / {args.lr}")
    print(f"Epochs        : {args.min_epoch}-{args.max_epoch}")
    print(f"Device        : {device}")
    print(f"Save dir      : {args.save_dir}")
    print("=" * 60)

    train_loader, val_loader, test_loader = common.build_dataloaders(args)
    loaders = {"train": train_loader, "val": val_loader, "test": test_loader}

    model = GraphAAV(
        hidden_dim=args.hidden_dim,
        num_layers=args.num_layers,
        dropout=args.dropout,
        device=device,
        num_heads=args.num_heads,
        esm_model=args.esm_model,
    )

    prefix = f"heads_{args.num_heads}_layers_{args.num_layers}_hidden_{args.hidden_dim}"
    initial_repr = pre_repr = None

    if args.mode == "all":
        # Representations are taken before training so that the pre/post
        # comparison uses the same (unshuffled) ordering of samples.
        eval_loaders = {
            "train": torch.utils.data.DataLoader(
                train_loader.dataset, batch_size=args.batch_size, shuffle=False,
                collate_fn=common.collate_fn,
            ),
            "val": val_loader,
            "test": test_loader,
        }
        print("\nExtracting initial ESM representations...")
        initial_repr = extract_representations(model, eval_loaders, "initial",
                                               use_gnn=False)
        save_representations(
            initial_repr,
            os.path.join(args.save_dir, f"esm_representations_{prefix}.csv"),
        )

        print("\nExtracting pre-training GNN representations...")
        pre_repr = extract_representations(model, eval_loaders, "pre-training")
        save_representations(
            pre_repr,
            os.path.join(args.save_dir, f"gnn_representations_{prefix}_pre.csv"),
        )

    history, _ = train_model(model, train_loader, val_loader, args, device)
    evaluate_and_report(model, loaders, args, device, history)

    if args.mode == "all":
        print("\nExtracting post-training GNN representations...")
        post_repr = extract_representations(model, eval_loaders, "post-training")
        save_representations(
            post_repr,
            os.path.join(args.save_dir, f"gnn_representations_{prefix}_post.csv"),
        )
        if args.compare_representations:
            plot_representation_comparison(
                initial_repr, pre_repr, post_repr,
                os.path.join(args.save_dir, "representation_comparison"), prefix,
            )

    print(f"\nDone. Results written to {args.save_dir}")


if __name__ == "__main__":
    main()
