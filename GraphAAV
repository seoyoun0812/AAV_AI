def create_parity_plot(true_values, pred_values, save_path, experiment_name=""):
    true_values = np.array(true_values)
    pred_values = np.array(pred_values)
    
    os.makedirs(save_path, exist_ok=True)
    
    fig = plt.figure(figsize=(12, 12))
    gs = fig.add_gridspec(3, 3, width_ratios=[1, 4, 1], height_ratios=[1, 4, 1],
                         hspace=0, wspace=0)
    
    ax_main = fig.add_subplot(gs[1, 1])
    ax_top = fig.add_subplot(gs[0, 1], sharex=ax_main)
    ax_right = fig.add_subplot(gs[1, 2], sharey=ax_main)
    
    min_val = min(min(true_values), min(pred_values))
    max_val = max(max(true_values), max(pred_values))
    
    range_buffer = (max_val - min_val) * 0.05
    plot_min = min_val - range_buffer
    plot_max = max_val + range_buffer
    
    n_bins = 100
    bins = np.linspace(plot_min, plot_max, n_bins+1)
    
    ax_main.scatter(true_values, pred_values, c='blue', alpha=0.6, edgecolors='w', 
               s=50, label='Test predictions')
    
    ax_main.plot([plot_min, plot_max], [plot_min, plot_max], 'k--', 
                linewidth=2, label='y = x', alpha=0.8)
    
    mse = np.mean((true_values - pred_values) ** 2)
    mae = np.mean(np.abs(true_values - pred_values))
    r2 = np.corrcoef(true_values, pred_values)[0, 1]**2 if len(set(true_values)) > 1 else 0.0
    n_samples = len(true_values)
    ax_main.text(plot_min + (plot_max - plot_min) * 0.05, 
                plot_max - (plot_max - plot_min) * 0.15,
                 f'Test data\nN: {n_samples}\nMAE: {mae:.4f}\n$R^2$: {r2:.4f}',
                fontsize=12, bbox=dict(facecolor='white', alpha=0.8))
    
    ax_main.set_xlabel('True Values', fontsize=14)
    ax_main.set_ylabel('Predicted Values', fontsize=14)
    ax_main.set_xlim(plot_min, plot_max)
    ax_main.set_ylim(plot_min, plot_max)
    
    ax_top.hist(true_values, bins=bins, density=True, alpha=0.7, 
               color='lightblue', edgecolor='black', linewidth=0.5)
    
    try:
        kde_true = gaussian_kde(true_values)
        x_range = np.linspace(plot_min, plot_max, 200)
        density_true = kde_true(x_range)
        ax_top.plot(x_range, density_true, 'b-', linewidth=2, label='True values density')
    except:
        pass
    
    ax_top.set_xlim(plot_min, plot_max)
    ax_top.set_ylabel('')
    ax_top.tick_params(axis='x', labelbottom=False)
    ax_top.set_yticks([])
    
    ax_right.hist(pred_values, bins=bins, density=True, alpha=0.7, 
                 color='lightblue', edgecolor='black', linewidth=0.5, 
                 orientation='horizontal')
    
    try:
        kde_pred = gaussian_kde(pred_values)
        y_range = np.linspace(plot_min, plot_max, 200)
        density_pred = kde_pred(y_range)
        ax_right.plot(density_pred, y_range, 'b-', linewidth=2, label='Predicted values density')
    except:
        pass
    
    ax_right.set_ylim(plot_min, plot_max)
    ax_right.set_xlabel('')
    ax_right.tick_params(axis='y', labelleft=False)
    ax_right.set_xticks([])
    
    for spine in ax_top.spines.values():
        spine.set_visible(False)
    for spine in ax_right.spines.values():
        spine.set_visible(False)
    
    title = 'ESM-GNN Parity Plot'
    if experiment_name:
        title += f'\n{experiment_name}'
    fig.suptitle(title, fontsize=16, y=0.95)
    
    plt.savefig(os.path.join(save_path, 'parity_plot_with_density.png'), dpi=300, bbox_inches='tight')
    plt.close()
    
    print(f"Parity plot saved to: {os.path.join(save_path, 'parity_plot_with_density.png')}")
    
    return {
        'mse': float(mse), 
        'mae': float(mae), 
        'r2': float(r2)
    }


